{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goldplated Photos",
  "version": "0.1.0",
  "identifier": "photos.goldplated.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goldplated Photos",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "copyright": "© Kristijan Lukacin",
    "category": "Photography",
    "shortDescription": "Photo management and gallery publishing",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
