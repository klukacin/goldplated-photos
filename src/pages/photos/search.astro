---
// Photo & album search. SSR — results are computed per query.
// SECURITY: only PUBLIC content is searchable. Albums that are hidden, locked
// (password/shareToken) or sit under a locked ancestor never appear here,
// regardless of the visitor's cookies — search must not leak protected names.
export const prerender = false;

import { getAllAlbums, getPhotosForAlbum, type Album, type Photo } from '../../lib/albums';
import { albumMatchesQuery, photoMatchesQuery, normalizeQuery } from '../../lib/search-core';
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig } from '../../config';

const MIN_QUERY_LENGTH = 2;
const MAX_PHOTO_RESULTS = 200;

const url = new URL(Astro.request.url);
const query = normalizeQuery(url.searchParams.get('q') || '');
const queryTooShort = query.length > 0 && query.length < MIN_QUERY_LENGTH;

interface PhotoResult {
  photo: Photo;
  albumPath: string;
  albumTitle: string;
}

let albumResults: { album: Album; path: string }[] = [];
let photoResults: PhotoResult[] = [];
let photoResultsCapped = false;

if (query.length >= MIN_QUERY_LENGTH) {
  const albums = await getAllAlbums();
  const byPath = new Map(albums.map(a => [a.id.replace('/index.md', ''), a]));

  const isLocked = (a: Album) => !!a.data.password || !!a.data.shareToken;

  // An album is publicly searchable when neither it nor any ancestor is
  // hidden or locked.
  const isPublicChain = (albumPath: string): boolean => {
    const parts = albumPath.split('/');
    for (let i = parts.length; i > 0; i--) {
      const ancestor = byPath.get(parts.slice(0, i).join('/'));
      if (ancestor && (isLocked(ancestor) || ancestor.data.hidden)) return false;
    }
    return true;
  };

  const publicAlbums = albums
    .map(a => ({ album: a, path: a.id.replace('/index.md', '') }))
    .filter(({ path }) => isPublicChain(path));

  albumResults = publicAlbums.filter(({ album }) =>
    albumMatchesQuery(query, album.data)
  );

  outer: for (const { album, path } of publicAlbums) {
    const photos = await getPhotosForAlbum(path);
    for (const photo of photos) {
      if (photo.isVideo) continue;
      if (photoMatchesQuery(query, photo)) {
        if (photoResults.length >= MAX_PHOTO_RESULTS) {
          photoResultsCapped = true;
          break outer;
        }
        photoResults.push({ photo, albumPath: path, albumTitle: album.data.title });
      }
    }
  }
}

const hasResults = albumResults.length > 0 || photoResults.length > 0;
---

<Layout title={query ? `Search: ${query}` : 'Search'}>
  <SEO
    slot="head"
    title={query ? `Search: ${query}` : 'Search'}
    description={`Search photos and albums — ${siteConfig.name}`}
    image={siteConfig.defaultOgImage}
    noIndex={true}
  />
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/home">Home</a><span class="separator">/</span></li>
        <li><a href="/photos">Photos</a><span class="separator">/</span></li>
        <li><span class="current">Search</span></li>
      </ol>
    </nav>

    <h1>Search</h1>

    <form class="search-form" method="GET" action="/photos/search" role="search">
      <input
        type="search"
        name="q"
        value={query}
        placeholder="Photo name, camera, date (2025-06-14) or album…"
        aria-label="Search photos and albums"
        autofocus
      />
      <button type="submit">Search</button>
    </form>

    {queryTooShort && <p class="hint">Type at least {MIN_QUERY_LENGTH} characters.</p>}

    {query.length >= MIN_QUERY_LENGTH && !hasResults && (
      <p class="empty">No results for “{query}”.</p>
    )}

    {albumResults.length > 0 && (
      <section class="results-section">
        <h2>Albums ({albumResults.length})</h2>
        <ul class="album-results">
          {albumResults.map(({ album, path }) => (
            <li>
              <a href={`/photos/${path}`} class="album-result">
                <span class="album-result-title">{album.data.title}</span>
                {album.data.description && <span class="album-result-desc">{album.data.description}</span>}
                {(album.data.tags || []).length > 0 && (
                  <span class="album-result-tags">{(album.data.tags || []).map(t => `#${t}`).join(' ')}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {photoResults.length > 0 && (
      <section class="results-section">
        <h2>Photos ({photoResults.length}{photoResultsCapped ? '+' : ''})</h2>
        {photoResultsCapped && (
          <p class="hint">Showing the first {MAX_PHOTO_RESULTS} matches — refine the query for more precise results.</p>
        )}
        <div class="photo-results">
          {photoResults.map(({ photo, albumPath, albumTitle }) => (
            <a
              class="photo-result"
              href={`/photos/${albumPath}?photo=${encodeURIComponent(photo.filename)}`}
              title={`${photo.filename} — ${albumTitle}`}
            >
              <img
                src={`/api/thumbnail?path=${encodeURIComponent(`${albumPath}/${photo.filename}`)}&size=small&v=3`}
                alt={photo.filename}
                loading="lazy"
                decoding="async"
                width={photo.width}
                height={photo.height}
                style={photo.blur ? `background-image:url(${photo.blur});background-size:cover` : undefined}
              />
              <span class="photo-result-name">{photo.filename}</span>
              <span class="photo-result-album">{albumTitle}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <Footer />
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .breadcrumbs ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-size: var(--text-sm, 0.9rem);
  }
  .breadcrumbs a { color: var(--color-text-secondary, #404040); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .separator { margin-left: 0.5rem; color: var(--color-text-muted, #666); }
  .breadcrumbs .current { color: var(--color-text, #0a0a0a); font-weight: 600; }

  h1 { margin: 0 0 1rem; }

  .search-form {
    display: flex;
    gap: 0.5rem;
    max-width: 560px;
    margin-bottom: 1.5rem;
  }
  .search-form input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font: inherit;
    min-width: 0;
  }
  .search-form input:focus-visible {
    outline: 3px solid var(--color-focus, #2563eb);
    outline-offset: 1px;
  }
  .search-form button {
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: 8px;
    background: #0a0a0a;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .search-form button:hover { background: #333; }

  .hint { color: var(--color-text-muted, #666); font-size: 0.9rem; }
  .empty { color: var(--color-text-secondary, #404040); padding: 1.5rem 0; }

  .results-section { margin-top: 2rem; }
  .results-section h2 { font-size: var(--text-xl, 1.25rem); margin-bottom: 1rem; }

  .album-results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .album-result {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .album-result:hover { border-color: #0a0a0a; background: #fafafa; }
  .album-result-title { font-weight: 600; }
  .album-result-desc { color: var(--color-text-secondary, #404040); font-size: 0.9rem; }
  .album-result-tags { color: #1976d2; font-size: 0.8rem; }

  .photo-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }
  .photo-result {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
  }
  .photo-result img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .photo-result-name {
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .photo-result-album {
    font-size: 0.75rem;
    color: var(--color-text-muted, #666);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .photo-results { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  }
</style>
