---
// Tag page — lists all non-hidden albums carrying a tag.
// Prerendered: one static page per tag found in the collection.
export const prerender = true;

import { getAllAlbums, getAlbumCoverPhoto } from '../../../lib/albums';
import { resolveChainVisibility } from '../../../lib/access-core';
import Layout from '../../../layouts/Layout.astro';
import SEO from '../../../components/SEO.astro';
import AlbumGrid from '../../../components/AlbumGrid.astro';
import Footer from '../../../components/Footer.astro';
import { siteConfig } from '../../../config';

export async function getStaticPaths() {
  const albums = await getAllAlbums();
  const paths = new Map(albums.map(a => [a.id.replace('/index.md', ''), a]));
  const tags = new Set<string>();
  for (const album of albums) {
    // Same hidden rule as the page body, so no tag gets an empty page
    if (resolveChainVisibility(album.id.replace('/index.md', ''), p => paths.get(p)?.data).hidden) continue;
    for (const tag of album.data.tags || []) {
      const clean = tag.trim();
      if (clean) tags.add(clean);
    }
  }
  return [...tags].map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;

const allAlbums = await getAllAlbums();
const byPath = new Map(allAlbums.map(a => [a.id.replace('/index.md', ''), a]));
// Lock and hidden are inherited, so ask about the whole chain, not the album
// alone: an album inside a locked collection is protected content too.
const visibilityOf = (albumPath: string) =>
  resolveChainVisibility(albumPath, p => byPath.get(p)?.data);

const albums = allAlbums
  .filter(a => (a.data.tags || []).some(t => t.trim() === tag))
  .filter(a => !visibilityOf(a.id.replace('/index.md', '')).hidden)
  .sort((a, b) => {
    const orderA = a.data.order ?? Infinity;
    const orderB = b.data.order ?? Infinity;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.title.localeCompare(b.data.title);
  });

// SECURITY: prerendered page — locked albums get no cover photo baked in, and
// are marked so the grid shows them as locked rather than as open albums.
const albumsWithCovers = await Promise.all(
  albums.map(async (album) => {
    const albumPath = album.id.replace('/index.md', '');
    if (visibilityOf(albumPath).locked) {
      return { album, coverPhotoUrl: null as string | null, lockedByAncestor: true };
    }
    const coverPhotoUrl = await getAlbumCoverPhoto(albumPath, album.data.thumbnail);
    return { album, coverPhotoUrl };
  })
);
---

<Layout title={`Tag: ${tag}`}>
  <SEO
    slot="head"
    title={`Tag: ${tag}`}
    description={`Albums tagged "${tag}" — ${siteConfig.name}`}
    image={siteConfig.defaultOgImage}
  />
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/home">Home</a><span class="separator">/</span></li>
        <li><a href="/photos">Photos</a><span class="separator">/</span></li>
        <li><span class="current">#{tag}</span></li>
      </ol>
    </nav>

    <div class="tag-header">
      <h1>#{tag}</h1>
      <p class="tag-count">{albums.length} album{albums.length === 1 ? '' : 's'}</p>
    </div>

    {albumsWithCovers.length > 0 ? (
      <AlbumGrid albums={albumsWithCovers} isParentProtected={false} hasParentAccess={false} />
    ) : (
      <p class="empty">No albums with this tag.</p>
    )}

    <Footer />
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .breadcrumbs ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-size: var(--text-sm, 0.9rem);
  }
  .breadcrumbs a { color: var(--color-text-secondary, #404040); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .separator { margin-left: 0.5rem; color: var(--color-text-muted, #666); }
  .breadcrumbs .current { color: var(--color-text, #0a0a0a); font-weight: 600; }

  .tag-header { margin-bottom: 2rem; }
  .tag-header h1 { margin: 0; font-size: var(--text-3xl, 2rem); }
  .tag-count { color: var(--color-text-secondary, #404040); margin-top: 0.25rem; }
  .empty { color: var(--color-text-muted, #666); padding: 2rem 0; }
</style>
