<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';
  // Overlay markup lives in src/lib/media-info.ts so the escaping of
  // file-supplied EXIF/ffprobe strings can be unit-tested.
  import { formatExifData, formatVideoInfo } from '../lib/media-info';
  // Chrome and Firefox cannot decode HEIC, so the Original-quality toggle has
  // to keep serving the transcoded thumbnail for those files.
  import { browserSafeImageUrl, needsBrowserTranscode } from '../lib/image-formats';
  import { buildPhotoShareUrl } from '../lib/share-url';

  // Current photo URL for EXIF data
  let currentPhotoUrl = '';

  // EXIF cache
  const exifCache = new Map();

  // Thumbnail size cache
  const thumbnailSizeCache = new Map<string, number>();

  async function getThumbnailSize(thumbnailUrl: string): Promise<number> {
    if (thumbnailSizeCache.has(thumbnailUrl)) {
      return thumbnailSizeCache.get(thumbnailUrl)!;
    }
    try {
      const response = await fetch(thumbnailUrl, { method: 'HEAD' });
      const size = parseInt(response.headers.get('Content-Length') || '0');
      thumbnailSizeCache.set(thumbnailUrl, size);
      return size;
    } catch {
      return 0;
    }
  }

  // Format file size: KB when < 1MB, otherwise MB
  function formatFileSize(bytes: number): string {
    if (bytes < 1024 * 1024) {
      return `${Math.round(bytes / 1024)} KB`;
    }
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  // Gallery navigation state
  let currentFocusedIndex = -1; // Start at -1 so first arrow press focuses first photo
  // Canonical index space for grid navigation: `.photo-item` elements (photos
  // AND videos) in their CURRENT DOM order. Sorting reorders the DOM nodes, so
  // always re-query at use time instead of holding a NodeList from load.
  const getPhotoItems = (): HTMLElement[] =>
    Array.from(document.querySelectorAll<HTMLElement>('#photo-gallery .photo-item'));
  // Static list of photo links (excludes videos) — used only to ATTACH
  // listeners once; indexes into it are never mixed with photo-item indexes.
  const photoLinks = document.querySelectorAll('.photo-link');

  // Slideshow state
  const galleryEl = document.getElementById('photo-gallery');
  const isSlideshowAlbum = galleryEl?.dataset.slideshow === 'true';
  const slideshowInterval = parseInt(galleryEl?.dataset.slideshowInterval || '5000') || 5000;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let autoStartSlideshow = false;

  // Video info cache
  const videoInfoCache = new Map();

  // ============ Share Modal Functionality ============
  const shareToast = document.getElementById('share-toast');
  const shareModal = document.getElementById('share-modal');
  const shareModalThumb = document.getElementById('share-modal-thumb') as HTMLImageElement;
  const shareModalFilename = document.getElementById('share-modal-filename');

  // Get share config from modal data attributes
  const shareConfig = {
    albumPath: shareModal?.dataset.albumPath || '',
    albumToken: shareModal?.dataset.albumToken || '',
    isProtected: shareModal?.dataset.isProtected === 'true',
    hasAccess: shareModal?.dataset.hasAccess === 'true',
    siteUrl: shareModal?.dataset.siteUrl || window.location.origin
  };

  // ============ Client Proofing ============
  const proofingBar = document.getElementById('proofing-bar');
  const proofingEnabled = !!proofingBar;
  const proofingAlbumPath = proofingBar?.dataset.albumPath || '';
  const proofingAlbumToken = proofingBar?.dataset.albumToken || '';
  const proofingStorageKey = `proofing_${proofingAlbumPath}`;
  // filename -> comment (null = no comment)
  const proofingSelections = new Map<string, string | null>();

  function proofingLoad() {
    try {
      const raw = localStorage.getItem(proofingStorageKey);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      for (const [filename, comment] of Object.entries(parsed)) {
        proofingSelections.set(filename, typeof comment === 'string' ? comment : null);
      }
    } catch {
      // Corrupt state — start fresh
    }
  }

  function proofingSave() {
    try {
      localStorage.setItem(proofingStorageKey, JSON.stringify(Object.fromEntries(proofingSelections)));
    } catch {
      // localStorage unavailable (private mode) — selection lives in memory only
    }
  }

  function proofingIsSelected(filename: string): boolean {
    return proofingSelections.has(filename);
  }

  function proofingToggle(filename: string) {
    if (!filename) return;
    if (proofingSelections.has(filename)) {
      proofingSelections.delete(filename);
    } else {
      proofingSelections.set(filename, null);
    }
    proofingSave();
    proofingUpdateUI();
  }

  function currentLightboxFilename(): string {
    return currentPhotoUrl.split('/').pop() || '';
  }

  function proofingUpdateUI() {
    if (!proofingEnabled) return;
    document.querySelectorAll<HTMLElement>('.proof-heart').forEach(btn => {
      const selected = proofingIsSelected(btn.dataset.filename || '');
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-pressed', selected.toString());
    });
    const count = proofingSelections.size;
    const countEl = document.getElementById('proofing-count');
    if (countEl) countEl.textContent = `${count} selected`;
    if (proofingBar) proofingBar.hidden = count === 0;
    // Lightbox heart (created dynamically by the custom toolbar)
    const lightboxHeart = document.querySelector('.pswp-btn-heart');
    if (lightboxHeart) {
      lightboxHeart.classList.toggle('selected', proofingIsSelected(currentLightboxFilename()));
    }
  }

  function renderProofingList() {
    const list = document.getElementById('proofing-list');
    if (!list) return;
    list.innerHTML = '';

    if (proofingSelections.size === 0) {
      list.innerHTML = '<p class="proofing-empty">No photos selected yet. Tap the heart on the photos you like.</p>';
      return;
    }

    for (const [filename, comment] of proofingSelections) {
      const item = document.createElement('div');
      item.className = 'proofing-item';

      const img = document.createElement('img');
      img.src = `/api/thumbnail?path=${encodeURIComponent(`${proofingAlbumPath}/${filename}`)}&size=small&v=3`;
      img.alt = filename;
      img.loading = 'lazy';
      item.appendChild(img);

      const fields = document.createElement('div');
      fields.className = 'proofing-item-fields';
      const name = document.createElement('span');
      name.className = 'proofing-item-name';
      name.textContent = filename;
      fields.appendChild(name);
      const textarea = document.createElement('textarea');
      textarea.maxLength = 500;
      textarea.placeholder = 'Note for this photo (optional)';
      textarea.value = comment || '';
      textarea.addEventListener('input', () => {
        proofingSelections.set(filename, textarea.value.trim() || null);
        proofingSave();
      });
      fields.appendChild(textarea);
      item.appendChild(fields);

      const remove = document.createElement('button');
      remove.className = 'proofing-item-remove';
      remove.type = 'button';
      remove.title = 'Remove from selection';
      remove.setAttribute('aria-label', `Remove ${filename} from selection`);
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        proofingSelections.delete(filename);
        proofingSave();
        proofingUpdateUI();
        renderProofingList();
      });
      item.appendChild(remove);

      list.appendChild(item);
    }
  }

  async function proofingSend() {
    const sendBtn = document.getElementById('proofing-send-btn') as HTMLButtonElement | null;
    if (!sendBtn || proofingSelections.size === 0) return;

    const nameInput = document.getElementById('proofing-name') as HTMLInputElement | null;
    const payload = {
      albumPath: proofingAlbumPath,
      name: nameInput?.value.trim() || null,
      selections: [...proofingSelections].map(([filename, comment]) => ({ filename, comment }))
    };

    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending…';
    try {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (proofingAlbumToken) headers['X-Album-Token'] = proofingAlbumToken;
      const response = await fetch('/api/proofing', {
        method: 'POST',
        headers,
        body: JSON.stringify(payload)
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.error || 'Failed to send selection');
      }
      proofingSelections.clear();
      proofingSave();
      proofingUpdateUI();
      document.getElementById('proofing-modal')?.classList.remove('active');
      document.body.style.overflow = '';
      showToast(`Selection sent (${data.count} photos). Thank you!`);
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Failed to send selection');
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send selection';
    }
  }

  function initProofing() {
    if (!proofingEnabled) return;
    proofingLoad();
    proofingUpdateUI();

    document.querySelectorAll<HTMLElement>('.proof-heart').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        proofingToggle(btn.dataset.filename || '');
      });
    });

    const proofingModal = document.getElementById('proofing-modal');
    const openModal = () => {
      renderProofingList();
      proofingModal?.classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    const closeModal = () => {
      proofingModal?.classList.remove('active');
      document.body.style.overflow = '';
      proofingUpdateUI(); // comments/removals may have changed
    };

    document.getElementById('proofing-review-btn')?.addEventListener('click', openModal);
    document.getElementById('proofing-clear-btn')?.addEventListener('click', () => {
      proofingSelections.clear();
      proofingSave();
      proofingUpdateUI();
    });
    proofingModal?.querySelector('.proofing-modal-close')?.addEventListener('click', closeModal);
    proofingModal?.addEventListener('click', (e) => {
      if (e.target === proofingModal) closeModal();
    });
    document.getElementById('proofing-send-btn')?.addEventListener('click', proofingSend);
  }

  initProofing();

