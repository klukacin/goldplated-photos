# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log


# environment variables
.env
.env.production
.access-secret

# macOS-specific files
.DS_Store
._*

# jetbrains setting folder
.idea/

# thumbnail cache
.meta/

# server PID files
.dev.pid
.admin.pid

# Marketing website (separate project, not in git)
marketing_website/

# Album content (personal photos - excluded from repo)
src/content/albums/

# Home page content (personal)
src/content/home/

# Meta files
*.meta.yaml
*~

# Images and Videos
*.jpg
*.jpeg
*.png
# …but the desktop app's own icons are not photographs, and without them
# `generate_context!` has nothing to embed and a clean clone cannot build.
!desktop/app/src-tauri/icons/*.png
*.gif
*.webp
*.tiff
*.bmp
*.heic
*.heif
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
.private/
docs/site/

# Agent worktrees live here; they are full checkouts of other branches.
.claude/worktrees/

# Test fixtures are not personal photos — without these negations the *.heic
# and *.webp ignores above silently drop them from the repo, and CI fails on
# files that exist on every dev machine (the same way the app icons once
# vanished under *.png).
!desktop/crates/gpp-core/tests/fixtures/*.heic
!desktop/crates/gpp-core/tests/fixtures/*.webp

# Full-scope sync store (desktop app originals + metadata; never gallery content)
.sync-full/
